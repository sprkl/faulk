{
  "client_message": {
    "$defs": {
      "Command": {
        "description": "A Faulk command, tagged by its `type` field (e.g. `{\"type\": \"note.on\", ...}`).",
        "oneOf": [
          {
            "additionalProperties": false,
            "description": "List the MIDI inputs available to the engine. The answer is a `midi.inputs` event.",
            "properties": {
              "type": {
                "const": "midi.list_inputs",
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object",
            "x-undo": "none"
          },
          {
            "additionalProperties": false,
            "description": "Choose the MIDI input that plays the synth. `id` is an id from `midi.inputs`;\n`null` disconnects MIDI input.",
            "properties": {
              "id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "type": {
                "const": "midi.select_input",
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object",
            "x-undo": "host"
          },
          {
            "additionalProperties": false,
            "description": "Set a synth parameter. Values outside the parameter's range are clamped.\nUndo: set the parameter back to its previous value.",
            "properties": {
              "param": {
                "$ref": "#/$defs/SynthParam"
              },
              "type": {
                "const": "synth.set_param",
                "type": "string"
              },
              "value": {
                "format": "float",
                "type": "number"
              }
            },
            "required": [
              "type",
              "param",
              "value"
            ],
            "type": "object",
            "x-undo": "inverse"
          },
          {
            "additionalProperties": false,
            "description": "Start a note on the synth. `note` is a MIDI note number (60 = middle C),\n`velocity` 1 to 127 (0 acts as a note off). Not undoable: it changes no project data.",
            "properties": {
              "note": {
                "format": "uint8",
                "maximum": 255,
                "minimum": 0,
                "type": "integer"
              },
              "type": {
                "const": "note.on",
                "type": "string"
              },
              "velocity": {
                "format": "uint8",
                "maximum": 255,
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "type",
              "note",
              "velocity"
            ],
            "type": "object",
            "x-undo": "none"
          },
          {
            "additionalProperties": false,
            "description": "Release a note started with `note.on`. Not undoable: it changes no project data.",
            "properties": {
              "note": {
                "format": "uint8",
                "maximum": 255,
                "minimum": 0,
                "type": "integer"
              },
              "type": {
                "const": "note.off",
                "type": "string"
              }
            },
            "required": [
              "type",
              "note"
            ],
            "type": "object",
            "x-undo": "none"
          },
          {
            "additionalProperties": false,
            "description": "Release every playing note (panic button). Not undoable: it changes no project data.",
            "properties": {
              "type": {
                "const": "note.all_off",
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object",
            "x-undo": "none"
          }
        ]
      },
      "SynthParam": {
        "description": "A synth parameter, with its unit and range.",
        "oneOf": [
          {
            "const": "waveform",
            "description": "Oscillator waveform: 0 sine, 1 saw, 2 square, 3 triangle.",
            "type": "string"
          },
          {
            "const": "attack",
            "description": "Attack time in seconds, 0.002 to 30.",
            "type": "string"
          },
          {
            "const": "decay",
            "description": "Decay time in seconds, 0.002 to 30.",
            "type": "string"
          },
          {
            "const": "sustain",
            "description": "Sustain level, 0 to 1.",
            "type": "string"
          },
          {
            "const": "release",
            "description": "Release time in seconds, 0.002 to 30.",
            "type": "string"
          },
          {
            "const": "gain",
            "description": "Master gain, 0 to 1 (linear).",
            "type": "string"
          }
        ]
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "A message from the page to the helper.",
    "oneOf": [
      {
        "additionalProperties": false,
        "description": "Pair with the helper using the one-time code it displays. Only on `/pair`.",
        "properties": {
          "code": {
            "type": "string"
          },
          "type": {
            "const": "pair",
            "type": "string"
          }
        },
        "required": [
          "type",
          "code"
        ],
        "type": "object"
      },
      {
        "additionalProperties": false,
        "description": "Run a command on the helper's engine. Only on an authenticated `/session`.",
        "properties": {
          "command": {
            "$ref": "#/$defs/Command"
          },
          "type": {
            "const": "command",
            "type": "string"
          }
        },
        "required": [
          "type",
          "command"
        ],
        "type": "object"
      }
    ],
    "title": "ClientMessage"
  },
  "command": {
