{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/helper/:channel(stable|beta)/releases\\.:os(win|linux|osx)\\.json",
      "has": [{ "type": "host", "value": "get.faulk.app" }],
      "destination": "https://gpotfuhrpu6rafcn.public.blob.vercel-storage.com/helper/:os/:channel/releases.:os.json",
      "permanent": false
    },
    {
      "source": "/helper/packages/:file(FaulkHelper-\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?-(?:full|delta)\\.nupkg)",
      "has": [{ "type": "host", "value": "get.faulk.app" }],
      "destination": "https://gpotfuhrpu6rafcn.public.blob.vercel-storage.com/helper/win/packages/:file",
      "permanent": false
    },
    {
      "source": "/helper/windows",
      "has": [{ "type": "host", "value": "get.faulk.app" }],
      "destination": "https://gpotfuhrpu6rafcn.public.blob.vercel-storage.com/helper/win/stable/FaulkHelper-win-Setup.exe",
      "permanent": false
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "get.faulk.app" }],
      "destination": "https://gpotfuhrpu6rafcn.public.blob.vercel-storage.com/helper/win/stable/FaulkHelper-win-Setup.exe",
      "permanent": false
    }
  ]
}
