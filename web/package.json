{
  "name": "faulk-web",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "gen:protocol": "node scripts/gen-protocol.mjs",
    "gen:check": "node scripts/gen-protocol.mjs && git diff --exit-code -- src/lib/generated",
    "predev": "node scripts/gen-protocol.mjs",
    "prebuild": "node scripts/gen-protocol.mjs",
    "pretest": "node scripts/gen-protocol.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "dev": "node scripts/build-wasm.mjs && vite dev",
    "build": "node scripts/build-wasm.mjs && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo \"\"",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/build-wasm.mjs && vitest run",
    "test:e2e": "playwright test",
    "bench:project": "playwright test -c playwright.bench.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.2",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "json-schema-to-typescript": "^16.0.0",
    "ogl": "1.0.11",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.4",
    "ws": "^8.22.0"
  }
}
